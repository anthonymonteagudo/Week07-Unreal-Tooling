createNode transform -n "BridgeCompare";
	rename -uid "272E6F19-4712-DB94-3E78-B3A049458446";
createNode mesh -n "BridgeCompareShape" -p "BridgeCompare";
	rename -uid "78B7240B-4743-2AE5-A341-AEBD5E0FC428";
	setAttr -k off ".v";
	setAttr ".vir" yes;
	setAttr ".vif" yes;
	setAttr ".uvst[0].uvsn" -type "string" "map1";
	setAttr ".cuvs" -type "string" "map1";
	setAttr ".dcc" -type "string" "Diffuse";
	setAttr ".covm[0]"  0 1 1;
	setAttr ".cdvm[0]"  0 1 1;
