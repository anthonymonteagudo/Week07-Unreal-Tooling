{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Material and VFX assistants (practice mode)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Scripts/assistants.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--stage",
        "${input:uiStage}"
      ]
    },
    {
      "name": "Debug draft checkpoint (ordinary Python)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Scripts/lessons.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "run",
        "${input:checkpoint}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug pure Python rule tests (outside Unreal)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "Tests",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/Content/Python"
      }
    },
    {
      "name": "Debug offline Prop Inspector UI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Scripts/ui.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "--stage",
        "${input:propStage}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "checkpoint",
      "type": "pickString",
      "description": "Optional prop foundation checkpoint to debug (01–07)",
      "options": [
        "01",
        "02",
        "03",
        "04",
        "05",
        "06",
        "07"
      ],
      "default": "01"
    },
    {
      "id": "uiStage",
      "type": "pickString",
      "description": "Material/VFX UI: 1 functional, 2 guided, 3 refined",
      "options": [
        "1",
        "2",
        "3"
      ],
      "default": "3"
    },
    {
      "id": "propStage",
      "type": "pickString",
      "description": "Earlier Prop Inspector stage (reference only)",
      "options": [
        "1",
        "2",
        "3"
      ],
      "default": "3"
    }
  ]
}
