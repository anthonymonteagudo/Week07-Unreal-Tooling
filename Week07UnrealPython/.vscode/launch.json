{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Material and VFX assistants (practice mode)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Scripts/assistants.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--stage",
        "${input:uiStage}"
      ]
    },
    {
      "name": "Debug pure Python rule tests (outside Unreal)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "Tests",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/Content/Python"
      }
    }
  ],
  "inputs": [
    {
      "id": "uiStage",
      "type": "pickString",
      "description": "Material/VFX UI: 1 functional, 2 guided, 3 refined",
      "options": [
        "1",
        "2",
        "3"
      ],
      "default": "3"
    }
  ]
}
